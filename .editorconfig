# Analyzer / code-style config for VideoAbridge.
# CA* from Directory.Build.props AnalysisMode=All; treated as errors via TreatWarningsAsErrors.
root = true

[*.{cs,vb}]
# Opt into specific IDE rules as errors (do not elevate the whole Style category).
dotnet_diagnostic.IDE0010.severity = error
dotnet_diagnostic.IDE0028.severity = error
dotnet_diagnostic.IDE0031.severity = error
dotnet_diagnostic.IDE0074.severity = error
dotnet_diagnostic.IDE0250.severity = error
dotnet_diagnostic.IDE0251.severity = error
dotnet_diagnostic.IDE0290.severity = error
dotnet_diagnostic.IDE0301.severity = error
dotnet_diagnostic.IDE0305.severity = error
dotnet_diagnostic.IDE0370.severity = error

csharp_style_prefer_primary_constructors = true:error
dotnet_style_prefer_collection_expression = true:error
dotnet_style_prefer_compound_assignment = true:error
dotnet_style_null_propagation = true:error

# FluentAssertions returns AndConstraint<>; statement assertions are intentional.
[tests/**/*.cs]
dotnet_diagnostic.IDE0058.severity = silent
