<Window x:Class="VideoAbridge.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoAbridge.ViewModels"
        Title="Tasks"
        Height="360"
        Width="480"
        MinHeight="200"
        MinWidth="360"
        Background="#2D2D30"
        Icon="pack://application:,,,/Assets/VideoAbridge.ico"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <ListBox ItemsSource="{Binding Tasks}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LongTaskItem}">
                    <Border Background="#333337" Padding="12" CornerRadius="2">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button Content="✕"
                                        ToolTip="Cancel"
                                        Padding="6,2"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="✕"
                                        ToolTip="Dismiss"
                                        Padding="6,2"
                                        Command="{Binding DismissCommand}"
                                        Visibility="{Binding HasResultActions, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress}" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding HasResultActions, Converter={StaticResource BoolToVis}}">
                                    <Button Content="{Binding PrimaryActionLabel}"
                                            Command="{Binding PrimaryActionCommand}"
                                            Padding="10,4"
                                            Margin="0,0,8,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
