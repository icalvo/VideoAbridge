<Window x:Class="VideoAbridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:VideoAbridge.Controls"
        xmlns:vm="clr-namespace:VideoAbridge.ViewModels"
        Title="VideoAbridge"
        AutomationProperties.AutomationId="MainWindow"
        Height="820"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        Background="#2D2D30"
        Icon="pack://application:,,,/Assets/VideoAbridge.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="ToolbarBtnDisabledBg" Color="#55555A"/>
        <SolidColorBrush x:Key="ToolbarBtnDisabledFg" Color="#9A9A9E"/>
        <Style x:Key="ToolbarButtonBase" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ToolbarBtnDisabledBg}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource ToolbarBtnDisabledFg}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Unsaturated blue / green / red for the three toolbar groups -->
        <Style x:Key="ToolbarButtonBlue" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
            <Setter Property="Background" Value="#5C7A9E"/>
        </Style>
        <Style x:Key="ToolbarButtonGreen" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
            <Setter Property="Background" Value="#5C8A5C"/>
        </Style>
        <Style x:Key="ToolbarButtonRed" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
            <Setter Property="Background" Value="#9E5C5C"/>
        </Style>
        <Style x:Key="VersionTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C44E52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9E3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TasksPaneToggleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskLogButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#55555A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6A6A70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444448"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskActionCloseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C44E52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D65A5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9E3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource {x:Static SystemColors.MenuBarBrushKey}}"
              Foreground="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Video…"
                          Command="{Binding OpenVideoCommand}"
                          InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="E_xport…"
                          Command="{Binding ExportCommand}"
                          InputGestureText="Ctrl+E"
                          ToolTip="{Binding ExportToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
            </MenuItem>
            <MenuItem Header="_Edit" IsEnabled="{Binding ShowEditChrome}">
                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          InputGestureText="Ctrl+Z"
                          ToolTip="{Binding UndoToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          InputGestureText="Ctrl+Y"
                          ToolTip="{Binding RedoToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <Separator/>
                <MenuItem Header="Add Marker"
                          Command="{Binding AddMarkerAtPlayheadCommand}"
                          InputGestureText="M"
                          ToolTip="{Binding AddMarkerToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Delete Marker"
                          Command="{Binding DeleteMarkerCommand}"
                          InputGestureText="Delete"
                          ToolTip="{Binding DeleteMarkerToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <Separator/>
                <MenuItem Header="Delete Section"
                          Command="{Binding DeleteSectionCommand}"
                          InputGestureText="Ctrl+D"
                          ToolTip="{Binding DeleteSectionToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Restore Section"
                          Command="{Binding RestoreSectionCommand}"
                          InputGestureText="Ctrl+Shift+D"
                          ToolTip="{Binding RestoreSectionToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Delete Section from Start"
                          Command="{Binding DeleteSectionFromStartCommand}"
                          InputGestureText="Ctrl+Shift+Home"
                          ToolTip="{Binding DeleteSectionFromStartToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Delete Section to End"
                          Command="{Binding DeleteSectionToEndCommand}"
                          InputGestureText="Ctrl+Shift+End"
                          ToolTip="{Binding DeleteSectionToEndToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Restore Section from Start"
                          Command="{Binding RestoreSectionFromStartCommand}"
                          InputGestureText="Ctrl+Alt+Home"
                          ToolTip="{Binding RestoreSectionFromStartToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Restore Section to End"
                          Command="{Binding RestoreSectionToEndCommand}"
                          InputGestureText="Ctrl+Alt+End"
                          ToolTip="{Binding RestoreSectionToEndToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <Separator/>
                <MenuItem Header="Detect Scenes"
                          Command="{Binding DetectScenesCommand}"
                          InputGestureText="Ctrl+Shift+S"
                          ToolTip="{Binding DetectScenesToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
            </MenuItem>
            <MenuItem Header="_View" IsEnabled="{Binding HasVideoLoaded}">
                <MenuItem Header="Toggle Edit / _Preview"
                          Command="{Binding TogglePreviewModeCommand}"
                          InputGestureText="Tab"
                          ToolTip="{Binding TogglePreviewModeToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Go to _Beginning"
                          Command="{Binding GoToBeginningCommand}"
                          InputGestureText="Home"/>
                <MenuItem Header="_Tasks pane"
                          Command="{Binding ToggleTasksPaneCommand}"
                          InputGestureText="Ctrl+Shift+T"/>
                <Separator/>
                <MenuItem Header="Zoom to _abridged content"
                          Command="{Binding ZoomToAbridgedContentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          InputGestureText="Ctrl+1"/>
                <MenuItem Header="Zoom to _fit"
                          Command="{Binding ZoomToFitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          InputGestureText="Ctrl+0"/>
            </MenuItem>
            <MenuItem Header="_Version" IsEnabled="{Binding HasVideoLoaded}">
                <MenuItem Header="_New Version…"
                          Command="{Binding CreateVersionCommand}"
                          InputGestureText="Ctrl+N"
                          ToolTip="{Binding CreateVersionToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="_Duplicate Version…"
                          Command="{Binding DuplicateVersionCommand}"
                          InputGestureText="Ctrl+Shift+N"
                          ToolTip="{Binding DuplicateVersionToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="_Rename Version…"
                          Command="{Binding RenameVersionCommand}"
                          InputGestureText="F2"
                          ToolTip="{Binding RenameVersionToolTip}"
                          ToolTipService.ShowOnDisabled="True"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Visibility="{Binding ShowVersionTabs, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding VersionTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VersionTabViewModel}">
                        <Border Margin="4,4,0,4"
                                Padding="10,4"
                                CornerRadius="3"
                                Cursor="Hand"
                                Background="#3E3E42"
                                MouseLeftButtonUp="VersionTab_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#5C7A9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Button Content="×"
                                        Style="{StaticResource VersionTabCloseButton}"
                                        ToolTip="{Binding DataContext.DeleteVersionToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.DeleteVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"
                                        Click="VersionTabClose_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" Foreground="White" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DisplayPlayhead, StringFormat={}{0:hh\\:mm\\:ss\\.ff}}" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200" MinHeight="160"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Tasks sidebar: only beside preview, not the timeline. Expand/collapse is manual only. -->
            <Border Grid.Row="0" Grid.Column="0"
                    Width="280"
                    Background="#333337"
                    Margin="0,0,8,0"
                    Padding="12"
                    Visibility="{Binding IsTasksPaneOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="&lt;&lt;"
                                Style="{StaticResource TasksPaneToggleButton}"
                                ToolTip="Collapse"
                                VerticalAlignment="Center"
                                Command="{Binding CollapseTasksPaneCommand}"/>
                        <TextBlock Text="Tasks" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Tasks}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LongTaskItem}">
                                <Border Background="#2A2A2E" Padding="12" CornerRadius="2">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Button Content="✕"
                                                    Style="{StaticResource TaskActionCloseButton}"
                                                    ToolTip="Cancel"
                                                    Command="{Binding CancelCommand}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="✕"
                                                    Style="{StaticResource TaskActionCloseButton}"
                                                    ToolTip="Dismiss"
                                                    Command="{Binding DismissCommand}"
                                                    Visibility="{Binding HasResultActions, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="..."
                                                        Style="{StaticResource TaskLogButton}"
                                                        ToolTip="Show log"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ShowLogCommand}"/>
                                                <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding HasResultActions, Converter={StaticResource BoolToVis}}">
                                                <Button Content="{Binding PrimaryActionLabel}"
                                                        Command="{Binding PrimaryActionCommand}"
                                                        Padding="10,4"
                                                        Margin="0,0,8,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Collapsed strip: always visible when pane is closed -->
            <Border Grid.Row="0" Grid.Column="0"
                    Width="28"
                    Background="#333337"
                    Margin="0,0,8,0"
                    Visibility="{Binding ShowTasksPaneCollapsed, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Content=">>"
                            Style="{StaticResource TasksPaneToggleButton}"
                            ToolTip="Expand tasks"
                            Margin="2"
                            Command="{Binding ExpandTasksPaneCommand}"/>
                    <TextBlock Text="{Binding TasksPaneCollapsedLabel}"
                               FontWeight="Bold"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRunningTasks}" Value="True">
                                        <Setter Property="Foreground" Value="Yellow"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="Black" CornerRadius="2" ClipToBounds="True">
                <!-- Overlay lives inside VideoView Content so it sits above the Win32 video surface. -->
                <vlc:VideoView x:Name="VideoView">
                    <Grid x:Name="PreviewHost"
                          Background="#01000000"
                          MouseEnter="PreviewHost_MouseEnter"
                          MouseLeave="PreviewHost_MouseLeave"
                          MouseMove="PreviewHost_MouseMove">
                        <Image Source="{Binding PreviewSecondaryFrame}"
                               Stretch="Uniform"
                               Opacity="{Binding PreviewSecondaryOpacity}"
                               IsHitTestVisible="False"/>
                        <Rectangle Fill="Black"
                                   Opacity="{Binding PreviewBlackoutOpacity}"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="PlayPauseOverlayButton"
                                Width="72" Height="72"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Cursor="Hand"
                                Command="{Binding PlayPauseCommand}"
                                ToolTip="Play / Pause"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="#99000000" Stroke="#66FFFFFF" StrokeThickness="1"/>
                                        <Viewbox Width="28" Height="28"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Grid Width="24" Height="24">
                                                <Path x:Name="PlayIcon"
                                                      Fill="White"
                                                      Data="M 6,3 L 6,21 L 20,12 Z"
                                                      Visibility="Visible"/>
                                                <Canvas x:Name="PauseIcon" Visibility="Collapsed">
                                                    <Rectangle Canvas.Left="5" Canvas.Top="3" Width="5" Height="18" Fill="White" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle Canvas.Left="14" Canvas.Top="3" Width="5" Height="18" Fill="White" RadiusX="1" RadiusY="1"/>
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="PlayIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="PauseIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </vlc:VideoView>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Background="#333337" Margin="8,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding HasSelectedJoin, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Crossfade (s)" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="0 = hard cut. Click a Cut/XF on the timeline to select it."/>
                            <TextBox Text="{Binding SelectedCrossfadeSeconds, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,4"
                                     KeyDown="DurationTextBox_KeyDown"/>
                            <TextBlock Foreground="#AAA"
                                       Text="{Binding SelectedCrossfadeCap, StringFormat=Max: {0:0.###}s}"/>
                        </StackPanel>

                        <TextBlock Text="Start fade from black (s)" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="StartFadeTextBox"
                                 Text="{Binding FadeFromBlackSeconds, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,0,0,4"
                                 KeyDown="DurationTextBox_KeyDown"/>
                        <TextBlock Foreground="#AAA" Margin="0,0,0,16"
                                   Text="{Binding StartFadeCap, StringFormat=Max: {0:0.###}s}"/>

                        <TextBlock Text="End fade to black (s)" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <TextBox x:Name="EndFadeTextBox"
                                 Text="{Binding FadeToBlackSeconds, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,0,0,4"
                                 KeyDown="DurationTextBox_KeyDown"/>
                        <TextBlock Foreground="#AAA"
                                   Text="{Binding EndFadeCap, StringFormat=Max: {0:0.###}s}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8">
                <Button Content="{Binding PreviewModeToggleLabel}"
                        Command="{Binding TogglePreviewModeCommand}"
                        ToolTip="{Binding TogglePreviewModeToolTip}"
                        Style="{StaticResource ToolbarButtonBlue}"
                        Margin="0,0,20,0" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                            Visibility="{Binding ShowEditChrome, Converter={StaticResource BoolToVis}}">
                    <Button Content="Add Marker"
                            Command="{Binding AddMarkerAtPlayheadCommand}"
                            ToolTip="{Binding AddMarkerToolTip}"
                            Style="{StaticResource ToolbarButtonGreen}" Margin="0,0,8,0"/>
                    <Button Content="Delete Marker"
                            Command="{Binding DeleteMarkerCommand}"
                            ToolTip="{Binding DeleteMarkerToolTip}"
                            Style="{StaticResource ToolbarButtonGreen}" Margin="0,0,8,0"/>
                    <Button Content="Detect Scenes"
                            Command="{Binding DetectScenesCommand}"
                            ToolTip="{Binding DetectScenesToolTip}"
                            Style="{StaticResource ToolbarButtonGreen}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowEditChrome, Converter={StaticResource BoolToVis}}">
                    <Button Content="Delete Section"
                            Command="{Binding DeleteSectionCommand}"
                            ToolTip="{Binding DeleteSectionToolTip}"
                            Style="{StaticResource ToolbarButtonRed}" Margin="0,0,8,0"/>
                    <Button Content="Restore Section"
                            Command="{Binding RestoreSectionCommand}"
                            ToolTip="{Binding RestoreSectionToolTip}"
                            Style="{StaticResource ToolbarButtonRed}" Margin="0,0,8,0"/>
                    <Button Content="Delete Section from Start"
                            Command="{Binding DeleteSectionFromStartCommand}"
                            ToolTip="{Binding DeleteSectionFromStartToolTip}"
                            Style="{StaticResource ToolbarButtonRed}" Margin="0,0,8,0"/>
                    <Button Content="Delete Section to End"
                            Command="{Binding DeleteSectionToEndCommand}"
                            ToolTip="{Binding DeleteSectionToEndToolTip}"
                            Style="{StaticResource ToolbarButtonRed}" Margin="0,0,8,0"/>
                    <Button Content="Restore Section from Start"
                            Command="{Binding RestoreSectionFromStartCommand}"
                            ToolTip="{Binding RestoreSectionFromStartToolTip}"
                            Style="{StaticResource ToolbarButtonRed}" Margin="0,0,8,0"/>
                    <Button Content="Restore Section to End"
                            Command="{Binding RestoreSectionToEndCommand}"
                            ToolTip="{Binding RestoreSectionToEndToolTip}"
                            Style="{StaticResource ToolbarButtonRed}"/>
                </StackPanel>
            </StackPanel>

            <controls:TimelineControl x:Name="Timeline"
                                      Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                      Timeline="{Binding Timeline}"
                                      Playhead="{Binding DisplayPlayhead}"
                                      IsPreviewMode="{Binding IsPreviewMode}"
                                      AbridgedLayout="{Binding AbridgedLayout}"
                                      AudioPeakEnvelope="{Binding AudioPeakEnvelope}"
                                      PreviewExportPlan="{Binding PreviewExportPlan}"
                                      PreviewTimeMap="{Binding PreviewTimeMap}"
                                      PixelsPerSecond="{Binding PixelsPerSecond, Mode=TwoWay}"
                                      MinPixelsPerSecond="{Binding MinPixelsPerSecond, Mode=TwoWay}"
                                      MaxPixelsPerSecond="{Binding MaxPixelsPerSecond, Mode=TwoWay}"
                                      MarkerThumbs="{Binding MarkerThumbs}"
                                      SelectedMarkerIds="{Binding SelectedMarkerIds}"
                                      SelectedDeletedRunId="{Binding SelectedDeletedRunId, Mode=TwoWay}"/>
        </Grid>
    </DockPanel>
</Window>
