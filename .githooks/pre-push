#!/bin/sh
# Regenerate docs/readme-screenshot.png before push; fail if it changed.
# Skip: SKIP_README_SCREENSHOT=1 git push

if [ -n "$SKIP_README_SCREENSHOT" ]; then
  echo "Skipping README screenshot (SKIP_README_SCREENSHOT is set)."
  exit 0
fi

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT)
    ;;
  *)
    echo "Skipping README screenshot (Windows-only capture)."
    exit 0
    ;;
esac

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

if ! command -v pwsh >/dev/null 2>&1; then
  echo "pwsh is required to capture the README screenshot."
  exit 1
fi

pwsh -NoProfile -File "$ROOT/tools/capture-readme-screenshot.ps1" || exit 1

if ! git diff --quiet -- docs/readme-screenshot.png; then
  echo ""
  echo "docs/readme-screenshot.png was updated. Commit it, then push again."
  echo "  git add docs/readme-screenshot.png && git commit -m \"Update README screenshot\""
  echo "Or skip: SKIP_README_SCREENSHOT=1 git push"
  exit 1
fi

# Also fail if the file is untracked (first capture).
if [ -z "$(git ls-files -- docs/readme-screenshot.png)" ]; then
  if [ -f docs/readme-screenshot.png ]; then
    echo ""
    echo "docs/readme-screenshot.png is new. Add and commit it, then push again."
    echo "  git add docs/readme-screenshot.png && git commit -m \"Add README screenshot\""
    exit 1
  fi
fi

exit 0
